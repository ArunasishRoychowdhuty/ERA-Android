# Copy to /etc/era-gateway/era-gateway.env and replace both secrets.
# Generate admin token: python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
# Generate hash key:   python3 -c 'import secrets; print(secrets.token_hex(32))'
ERA_GATEWAY_ADMIN_TOKEN=REPLACE_WITH_RANDOM_48_BYTE_BASE64URL_SECRET
ERA_GATEWAY_HASH_KEY=REPLACE_WITH_64_HEX_CHARACTERS
ERA_GATEWAY_DATABASE=/var/lib/era-gateway/gateway.sqlite3
ERA_GATEWAY_PUBLIC_URL=https://era-gateway.<your-tailnet>.ts.net
ERA_GATEWAY_BIND=127.0.0.1
ERA_GATEWAY_PORT=8765
ERA_GATEWAY_PAIRING_TTL_SECONDS=120
ERA_GATEWAY_ACCESS_TTL_SECONDS=2592000
ERA_GATEWAY_HEARTBEAT_SECONDS=30
